    CAST(PostalCityID                   AS NVARCHAR(256)) AS PostalCityID,
    CAST(CreditLimit                    AS NVARCHAR(256)) AS CreditLimit,
    CAST(AccountOpenedDate              AS NVARCHAR(256)) AS AccountOpenedDate,
    CAST(StandardDiscountPercentage     AS NVARCHAR(256)) AS StandardDiscountPercentage,
    CAST(IsStatementSent                AS NVARCHAR(256)) AS IsStatementSent,
    CAST(IsOnCreditHold                 AS NVARCHAR(256)) AS IsOnCreditHold,
    CAST(PaymentDays                    AS NVARCHAR(256)) AS PaymentDays,
    CAST(PhoneNumber                    AS NVARCHAR(256)) AS PhoneNumber,
    CAST(FaxNumber                      AS NVARCHAR(256)) AS FaxNumber,
    CAST(DeliveryRun                    AS NVARCHAR(256)) AS DeliveryRun,
    CAST(RunPosition                    AS NVARCHAR(256)) AS RunPosition,
    CAST(WebsiteURL                     AS NVARCHAR(256)) AS WebsiteURL,
    CAST(DeliveryAddressLine1           AS NVARCHAR(256)) AS DeliveryAddressLine1,
    CAST(DeliveryAddressLine2           AS NVARCHAR(256)) AS DeliveryAddressLine2,
    CAST(DeliveryPostalCode             AS NVARCHAR(256)) AS DeliveryPostalCode,
    CAST(PostalAddressLine1             AS NVARCHAR(256)) AS PostalAddressLine1,
    CAST(PostalAddressLine2             AS NVARCHAR(256)) AS PostalAddressLine2,
    CAST(PostalPostalCode               AS NVARCHAR(256)) AS PostalPostalCode
FROM Sales.Customers</property>
