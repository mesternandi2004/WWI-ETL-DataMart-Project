                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(CustomerID                     AS NVARCHAR(256)) AS CustomerID,
    CAST(CustomerName                   AS NVARCHAR(256)) AS CustomerName,
    CAST(BillToCustomerID               AS NVARCHAR(256)) AS BillToCustomerID,
    CAST(CustomerCategoryID             AS NVARCHAR(256)) AS CustomerCategoryID,
