    <DTS:Executable
      DTS:refId="Package\Get Next LoadNumber"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1CE75EAB-B987-4C9A-86A9-C2CAB5E02D57}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Next LoadNumber"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F16C3F23-F861-4011-A0A2-9C108F73F6B5}"
          SQLTask:SqlStatementSource="DECLARE @TodayPrefix BIGINT =&#xA;    CAST(FORMAT(GETDATE(), 'yyyyMMdd') AS BIGINT) * 1000;&#xA;&#xA;SELECT&#xA;    @TodayPrefix +&#xA;    ISNULL(&#xA;        MAX(loadnumber) % 1000,&#xA;        0&#xA;    ) + 1 AS NextLoadNumber&#xA;FROM ETL_CTRL.etl.etl_load_audit&#xA;WHERE loadnumber BETWEEN @TodayPrefix AND @TodayPrefix + 999;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::LoadNumber" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
