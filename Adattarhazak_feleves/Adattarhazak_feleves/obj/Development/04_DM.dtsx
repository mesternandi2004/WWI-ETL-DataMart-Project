  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Dm dim city"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8B6A1F36-830B-4DA4-9307-59AD64D5A19B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Dm dim city"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="MERGE WWI_DM.dbo.DimCity AS dm&#xA;USING (SELECT * FROM WWI_DWH.dbo.DimCity WHERE ValidTo = CAST('9999-12-31' as DATE)) AS dwh&#xA;    ON dm.CityID = dwh.CityID&#xA;WHEN MATCHED AND (&#xA;       ISNULL(dm.CityName, '')          &lt;&gt; ISNULL(dwh.CityName, '')&#xA;    OR ISNULL(dm.StateProvinceName, '') &lt;&gt; ISNULL(dwh.StateProvinceName, '')&#xA;    OR ISNULL(dm.CountryName, '')       &lt;&gt; ISNULL(dwh.CountryName, '')&#xA;    OR ISNULL(dm.Continent, '')         &lt;&gt; ISNULL(dwh.Continent, '')&#xA;    OR ISNULL(dm.SalesTerritory, '')    &lt;&gt; ISNULL(dwh.SalesTerritory, '')&#xA;) THEN&#xA;    UPDATE SET&#xA;        dm.CityName          = dwh.CityName,&#xA;        dm.StateProvinceName = dwh.StateProvinceName,&#xA;        dm.CountryName       = dwh.CountryName,&#xA;        dm.Continent         = dwh.Continent,&#xA;        dm.SalesTerritory    = dwh.SalesTerritory&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (CityID, CityName, StateProvinceName, CountryName, Continent, SalesTerritory)&#xA;    VALUES (dwh.CityID, dwh.CityName, dwh.StateProvinceName, dwh.CountryName, dwh.Continent, dwh.SalesTerritory);&#xA;&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::cityrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DM dim deliverymethod"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F4D91F3C-FDEB-44FC-88A1-913909E41F2A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DM dim deliverymethod"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="MERGE WWI_DM.dbo.DimDeliveryMethod AS dm&#xA;USING (SELECT * FROM WWI_DWH.dbo.DimDeliveryMethod WHERE ValidTo = CAST('9999-12-31' as DATE)) AS dwh&#xA;    ON dm.DeliveryMethodID = dwh.DeliveryMethodID&#xA;WHEN MATCHED AND (&#xA;    ISNULL(dm.DeliveryMethodName, '') &lt;&gt; ISNULL(dwh.DeliveryMethodName, '')&#xA;) THEN&#xA;    UPDATE SET&#xA;        dm.DeliveryMethodName = dwh.DeliveryMethodName&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (DeliveryMethodID, DeliveryMethodName)&#xA;    VALUES (dwh.DeliveryMethodID, dwh.DeliveryMethodName);&#xA;&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::DeliveryMethodrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DM dim product"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5D7A1A52-F0BB-4C61-A79E-6AE49DA426C3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DM dim product"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="MERGE WWI_DM.dbo.DimProduct AS dm&#xA;USING (SELECT * FROM WWI_DWH.dbo.DimProduct WHERE ValidTo = CAST('9999-12-31' as DATE)) AS dwh&#xA;    ON dm.StockItemID = dwh.StockItemID&#xA;WHEN MATCHED AND (&#xA;       ISNULL(dm.StockItemName, '')  &lt;&gt; ISNULL(dwh.StockItemName, '')&#xA;    OR ISNULL(dm.Brand, '')          &lt;&gt; ISNULL(dwh.Brand, '')&#xA;    OR ISNULL(dm.Size, '')           &lt;&gt; ISNULL(dwh.Size, '')&#xA;    OR ISNULL(dm.ColorName, '')      &lt;&gt; ISNULL(dwh.ColorName, '')&#xA;    OR ISNULL(dm.UnitPrice, 0)       &lt;&gt; ISNULL(dwh.UnitPrice, 0)&#xA;    OR ISNULL(dm.TaxRate, 0)         &lt;&gt; ISNULL(dwh.TaxRate, 0)&#xA;) THEN&#xA;    UPDATE SET&#xA;        dm.StockItemName = dwh.StockItemName,&#xA;        dm.Brand         = dwh.Brand,&#xA;        dm.Size          = dwh.Size,&#xA;        dm.ColorName     = dwh.ColorName,&#xA;        dm.UnitPrice     = dwh.UnitPrice,&#xA;        dm.TaxRate       = dwh.TaxRate&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (StockItemID, StockItemName, Brand, Size, ColorName, UnitPrice, TaxRate)&#xA;    VALUES (dwh.StockItemID, dwh.StockItemName, dwh.Brand, dwh.Size, dwh.ColorName, dwh.UnitPrice, dwh.TaxRate);&#xA;&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::Productrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DM dim salesperson"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E886BD47-DCE0-4139-8A90-16171019924F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DM dim salesperson"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="MERGE WWI_DM.dbo.DimSalesperson AS dm&#xA;USING (SELECT * FROM WWI_DWH.dbo.DimSalesperson WHERE ValidTo = CAST('9999-12-31' as DATE)) AS dwh&#xA;    ON dm.PersonID = dwh.PersonID&#xA;WHEN MATCHED AND (&#xA;    ISNULL(dm.FullName, '')      &lt;&gt; ISNULL(dwh.FullName, '') OR&#xA;    ISNULL(dm.IsSalesperson, 0) &lt;&gt; ISNULL(dwh.IsSalesperson, 0)&#xA;) THEN&#xA;    UPDATE SET&#xA;        dm.FullName      = dwh.FullName,&#xA;        dm.IsSalesperson = dwh.IsSalesperson&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (PersonID, FullName, IsSalesperson)&#xA;    VALUES (dwh.PersonID, dwh.FullName, dwh.IsSalesperson);&#xA;&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::Salespersonrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DM dim_Costumer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{529D34CD-2138-4031-84C5-C8ECBD39AC39}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DM dim_Costumer"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="MERGE WWI_DM.dbo.DimCustomer AS dm&#xA;USING (SELECT * FROM WWI_DWH.dbo.DimCustomer WHERE ValidTo = CAST('9999-12-31' as DATE)) AS dwh&#xA;    ON dm.CustomerID = dwh.CustomerID&#xA;WHEN MATCHED AND (&#xA;       ISNULL(dm.CustomerName, '')            &lt;&gt; ISNULL(dwh.CustomerName, '')&#xA;    OR ISNULL(dm.CategoryName, '')            &lt;&gt; ISNULL(dwh.CategoryName, '')&#xA;    OR ISNULL(dm.BuyingGroupName, '')         &lt;&gt; ISNULL(dwh.BuyingGroupName, '')&#xA;    OR ISNULL(dm.DeliveryCityName, '')        &lt;&gt; ISNULL(dwh.DeliveryCityName, '')&#xA;    OR ISNULL(dm.DeliveryStateProvince, '')   &lt;&gt; ISNULL(dwh.DeliveryStateProvince, '')&#xA;    OR ISNULL(dm.DeliveryCountry, '')         &lt;&gt; ISNULL(dwh.DeliveryCountry, '')&#xA;) THEN&#xA;    UPDATE SET&#xA;        dm.CustomerName             = dwh.CustomerName,&#xA;        dm.CategoryName             = dwh.CategoryName,&#xA;        dm.BuyingGroupName          = dwh.BuyingGroupName,&#xA;        dm.DeliveryCityName         = dwh.DeliveryCityName,&#xA;        dm.DeliveryStateProvince    = dwh.DeliveryStateProvince,&#xA;        dm.DeliveryCountry          = dwh.DeliveryCountry&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;        CustomerID, CustomerName, CategoryName, BuyingGroupName,&#xA;        DeliveryCityName, DeliveryStateProvince, DeliveryCountry&#xA;    )&#xA;    VALUES (&#xA;        dwh.CustomerID, dwh.CustomerName, dwh.CategoryName, dwh.BuyingGroupName,&#xA;        dwh.DeliveryCityName, dwh.DeliveryStateProvince, dwh.DeliveryCountry&#xA;    );&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::costumerrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DM fact load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1FFBA00D-846A-4ACF-A01F-C80300852B9E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DM fact load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="INSERT INTO WWI_DM.dbo.FactSales (&#xA;    InvoiceLineID, InvoiceID, DimDateKey,&#xA;    DimCustomerID, DimProductID, DimSalespersonID,&#xA;    DimDeliveryMethodID, DimCityID,&#xA;    Quantity, UnitPrice, TaxRate, TaxAmount,&#xA;    LineProfit, ExtendedPrice&#xA;)&#xA;SELECT&#xA;    src.InvoiceLineID,&#xA;    src.InvoiceID,&#xA;    src.DimDateKey,&#xA;    dc.DimCustomerID,&#xA;    dp.DimProductID,&#xA;    ds.DimSalespersonID,&#xA;    ddm.DimDeliveryMethodID,&#xA;    dci.DimCityID,&#xA;    src.Quantity,&#xA;    src.UnitPrice,&#xA;    src.TaxRate,&#xA;    src.TaxAmount,&#xA;    src.LineProfit,&#xA;    src.ExtendedPrice&#xA;FROM WWI_DWH.dbo.FactSales src&#xA;    JOIN WWI_DM.dbo.DimCustomer dc&#xA;        ON dc.CustomerID = src.DimCustomerID&#xA;    JOIN WWI_DM.dbo.DimProduct dp&#xA;        ON dp.StockItemID = src.DimProductID&#xA;    JOIN WWI_DM.dbo.DimSalesperson ds&#xA;        ON ds.PersonID = src.DimSalespersonID&#xA;    JOIN WWI_DM.dbo.DimDeliveryMethod ddm&#xA;        ON ddm.DeliveryMethodID = src.DimDeliveryMethodID&#xA;    JOIN WWI_DM.dbo.DimCity dci&#xA;        ON dci.CityID = src.DimCityID&#xA;LEFT JOIN WWI_DM.dbo.FactSales f&#xA;    ON f.InvoiceLineID = src.InvoiceLineID&#xA;WHERE f.InvoiceLineID IS NULL;&#xA;SELECT @@ROWCOUNT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::Factrowcount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{e6f33640-23b3-422c-84c2-b2d23c83c26f}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52F0E10A-E756-4F0B-B1D3-D496BDC2E460}"
          SQLTask:SqlStatementSource="USE WWI_DM;&#xA;TRUNCATE TABLE dbo.FactSales;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
