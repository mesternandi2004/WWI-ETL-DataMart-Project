          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6BEAFC53-C168-4711-8A2E-ADC4363E5E4E}"
              SQLTask:SqlStatementSource="Insert into etl.etl_load_audit(&#xA;loadnumber,&#xA; layer_name,&#xA;table_name,&#xA; load_start_dts,&#xA;row_count,&#xA;status&#xA;) VALUES ( ?, 'DWH', 'fact_sales_dwh', GETDATE(), ?, 'Update');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
