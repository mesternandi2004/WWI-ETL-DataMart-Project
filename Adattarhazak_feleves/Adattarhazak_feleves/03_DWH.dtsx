        <DTS:Executable
          DTS:refId="Package\dim_product\SCD1 update"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{49be03a9-2bf9-48c1-b9de-6333d49ecdaf}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SCD1 update"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1EA88E48-106B-4D0D-A1CC-1E678E3BC29B}"
              SQLTask:SqlStatementSource="UPDATE d &#xA;SET&#xA;    d.UnitPrice     = s.UnitPrice,&#xA;    d.TaxRate       = s.TaxRate,&#xA;    d.LoadNumber    = ?&#xA;FROM WWI_DWH.dbo.DimProduct d&#xA;JOIN WWI_DWH.dbo.DimProductVW s&#xA;  ON d.StockItemID = s.StockItemID&#xA;WHERE d.ValidTo = CAST('9999-12-31' as date)&#xA;-- nincs SCD2 változás&#xA;AND NOT (&#xA;       ISNULL(d.StockItemName, '')      &lt;&gt; ISNULL(s.StockItemName, '')&#xA;    OR ISNULL(d.Brand, '')              &lt;&gt; ISNULL(s.Brand, '')&#xA;    OR ISNULL(d.Size, '')               &lt;&gt; ISNULL(s.Size, '')&#xA;    OR ISNULL(d.ColorName, '')          &lt;&gt; ISNULL(s.ColorName, '')&#xA;    OR ISNULL(d.UnitPackageName, '')    &lt;&gt; ISNULL(s.UnitPackageName, '')&#xA;    OR ISNULL(d.OuterPackageName, '')   &lt;&gt; ISNULL(s.OuterPackageName, '')&#xA;    OR ISNULL(d.StockGroupName, '')     &lt;&gt; ISNULL(s.StockGroupName, '')&#xA;)&#xA;-- van SCD1 változás&#xA;AND (&#xA;       ISNULL(d.UnitPrice, 0)   &lt;&gt; ISNULL(s.UnitPrice, 0)&#xA;    OR ISNULL(d.TaxRate, 0)     &lt;&gt; ISNULL(s.TaxRate, 0)&#xA;);&#xA;SELECT @@ROWCOUNT;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::Rowcount_SCD1U" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LoadNumber"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\dim_product\SCD2 Insert"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{67278c6a-5efb-4b22-9ece-d0ebf2acb21d}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SCD2 Insert"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1EA88E48-106B-4D0D-A1CC-1E678E3BC29B}"
              SQLTask:SqlStatementSource="INSERT INTO WWI_DWH.dbo.DimProduct (&#xA;    StockItemID,&#xA;    StockItemName,&#xA;    Brand,&#xA;    Size,&#xA;    ColorName,&#xA;    UnitPackageName,&#xA;    OuterPackageName,&#xA;    StockGroupName,&#xA;    UnitPrice,&#xA;    TaxRate,&#xA;    ValidFrom,&#xA;    ValidTo,&#xA;    LoadNumber&#xA;)&#xA;SELECT&#xA;     DISTINCT s.StockItemID,&#xA;    s.StockItemName,&#xA;    s.Brand,&#xA;    s.Size,&#xA;    s.ColorName,&#xA;    s.UnitPackageName,&#xA;    s.OuterPackageName,&#xA;    s.StockGroupName,&#xA;    s.UnitPrice,&#xA;    s.TaxRate,&#xA;    CAST(GETDATE() AS DATE) AS ValidFrom,&#xA;    CAST('9999-12-31' AS DATE)                   AS ValidTo,&#xA;    ?                       AS LoadNumber&#xA;FROM WWI_DWH.dbo.DimProductVW s&#xA;LEFT JOIN WWI_DWH.dbo.DimProduct d&#xA;  ON d.StockItemID = s.StockItemID&#xA; AND d.ValidTo  =  CAST('9999-12-31' as Date)&#xA;WHERE d.StockItemID IS NULL;&#xA;SELECT @@ROWCOUNT;&#xA;&#xA;WITH CTE AS (&#xA;    SELECT StockItemID, &#xA;           ROW_NUMBER() OVER (PARTITION BY StockItemID ORDER BY ValidFrom DESC) as rn&#xA;    FROM WWI_DWH.dbo.DimProduct&#xA;    WHERE ValidTo = CAST('9999-12-31' AS DATE)&#xA;)&#xA;DELETE FROM CTE WHERE rn &gt; 1;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::Rowcount_SCD2I" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LoadNumber"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\dim_product\SCD2 Update"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{d3875793-dcc4-408c-ab03-2502d8ffbb34}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SCD2 Update"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1EA88E48-106B-4D0D-A1CC-1E678E3BC29B}"
              SQLTask:SqlStatementSource="UPDATE d&#xA;SET d.ValidTo = DATEADD(DAY, -1, CAST(GETDATE() AS DATE)),&#xA;    d.LoadNumber = ?&#xA;FROM WWI_DWH.dbo.DimProduct d &#xA;JOIN WWI_DWH.dbo.DimProductVW s ON d.StockItemID = s.StockItemID&#xA;WHERE d.ValidTo = CAST('9999-12-31' as DATE)&#xA;  AND (ISNULL(d.StockItemName, '') &lt;&gt; ISNULL(s.StockItemName, '') OR&#xA;       ISNULL(d.Brand, '') &lt;&gt; ISNULL(s.Brand, '') OR&#xA;       ISNULL(d.Size, '') &lt;&gt; ISNULL(s.Size, '') OR&#xA;       ISNULL(d.ColorName, '') &lt;&gt; ISNULL(s.ColorName, '') OR&#xA;       ISNULL(d.UnitPackageName, '') &lt;&gt; ISNULL(s.UnitPackageName, '') OR&#xA;       ISNULL(d.OuterPackageName, '') &lt;&gt; ISNULL(s.OuterPackageName, '') OR&#xA;       ISNULL(d.StockGroupName, '') &lt;&gt; ISNULL(s.StockGroupName, ''));&#xA;&#xA;SELECT @@ROWCOUNT;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::Rowcount_SCD2U" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LoadNumber"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
